{
  "name": "prok-vacation-root",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "npm run dev --prefix web",
    "build": "node content/scripts/build-pack.mjs && npm run build --prefix web",
    "build:pack": "node content/scripts/build-pack.mjs",
    "seed:tmp": "node content/scripts/seed-from-tmp.mjs",
    "db:export-text-dml": "node content/scripts/export-text-dml.mjs",
    "sites:reseed": "python content/scripts/reseed-sites-from-pdf.py",
    "lint": "npm run lint --prefix web",
    "preview": "npm run preview --prefix web",
    "server": "python -m uvicorn app:app --host 0.0.0.0 --port 8083 --reload --app-dir server"
  }
}
